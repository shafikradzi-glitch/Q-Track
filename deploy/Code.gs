/* ===== Rules.gs ===== */
/**
 * Q-TRACK assurance rules. Pure functions over plain records: no Sheets, no Session.
 * Dates are ISO strings (yyyy-mm-dd); periods are yyyy-mm.
 */

const STATUS_RANK = { Green: 0, Amber: 1, Red: 2 };

/* ---------------- dates ---------------- */

function isoToDay_(iso) {
  if (!iso) return null;
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso));
  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / 864e5 : null;
}

function daysBetween_(fromIso, toIso) {
  const a = isoToDay_(fromIso), b = isoToDay_(toIso);
  return a == null || b == null ? null : b - a;
}

function addDays_(iso, n) {
  const d = new Date((isoToDay_(iso) + n) * 864e5);
  return d.toISOString().slice(0, 10);
}

const MONTH_NAMES_ = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
/** 2026-10-26 → 26 Oct 2026; 2026-10 → Oct 2026 (for alert text). */
function nice_(iso) {
  const m = /^(\d{4})-(\d{2})(?:-(\d{2}))?/.exec(String(iso || ''));
  if (!m) return iso ? String(iso) : '—';
  return (m[3] ? +m[3] + ' ' : '') + MONTH_NAMES_[+m[2] - 1] + ' ' + m[1];
}

function periodOf_(iso) { return String(iso).slice(0, 7); }

function shiftPeriod_(period, n) {
  const y = +period.slice(0, 4), m = +period.slice(5, 7) - 1 + n;
  const d = new Date(Date.UTC(y, m, 1));
  return d.toISOString().slice(0, 7);
}

/** The Friday that ends the week containing iso (weeks run Saturday–Friday). */
function fridayOf_(iso) {
  const day = new Date(isoToDay_(iso) * 864e5).getUTCDay(); // 0 Sun … 5 Fri
  return addDays_(iso, (5 - day + 7) % 7);
}

/* ---------------- Level 4 overall (RMM §9) ---------------- */

/**
 * Overall = worst applicable area. Grey counts as Amber. Grey overall when more than a
 * third of applicable areas are Grey. No applicable areas = Not assessed.
 */
function overallFromAreas(statuses) {
  const applicable = statuses.filter((s) => s && s !== 'N/A');
  if (!applicable.length) return 'Not assessed';
  const n = (s) => applicable.filter((x) => x === s).length;
  const grey = n('Grey');
  if (grey > applicable.length / 3) return 'Grey';
  if (n('Red')) return 'Red';
  if (n('Amber') + grey) return 'Amber';
  return 'Green';
}

function areaStatuses(a) {
  const out = [];
  for (let i = 1; i <= 10; i++) out.push(a['a' + i] || 'Grey');
  return out;
}

/** Lead – QA may move the overall result by one level, with a recorded rationale (RMM §9.2). */
function checkModeration(overall, moderatedTo, note) {
  if (!moderatedTo) return null;
  if (!(overall in STATUS_RANK) || !(moderatedTo in STATUS_RANK)) return 'Only a Green, Amber or Red result can be moderated.';
  if (Math.abs(STATUS_RANK[overall] - STATUS_RANK[moderatedTo]) !== 1) return 'Moderation may move the result by one level only.';
  if (!note || String(note).trim().length < 10) return 'Give the moderation rationale (at least a sentence).';
  return null;
}

/* ---------------- statistics ---------------- */

function median_(xs) {
  if (!xs.length) return null;
  const s = xs.slice().sort((a, b) => a - b), m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
}

/** Wilson score interval for k successes in n trials, 95%. */
function wilson(k, n, z) {
  z = z || 1.96;
  if (!n) return { p: null, lo: null, hi: null };
  const p = k / n, z2 = z * z, den = 1 + z2 / n;
  const centre = (p + z2 / (2 * n)) / den;
  const half = (z * Math.sqrt((p * (1 - p)) / n + z2 / (4 * n * n))) / den;
  return { p: p, lo: Math.max(0, centre - half), hi: Math.min(1, centre + half) };
}

/** c-chart over monthly counts: centre line c̄ and UCL = c̄ + 3√c̄; LCL floored at 0. */
function cChart(counts) {
  const cl = counts.length ? counts.reduce((a, b) => a + b, 0) / counts.length : 0;
  const ucl = cl + 3 * Math.sqrt(cl), lcl = Math.max(0, cl - 3 * Math.sqrt(cl));
  return { cl: cl, ucl: ucl, lcl: lcl, special: counts.map((c) => c > ucl) };
}

/* ---------------- NCR & CAPA (Level 2 references) ---------------- */

function ncrStats(ncrs, asOf, cfg) {
  const b1 = +cfg.ncrBand1 || 30, b2 = +cfg.ncrBand2 || 60, b3 = +cfg.ncrBand3 || 90;
  const live = ncrs.filter((r) => r.status !== 'Cancelled');
  const open = live.filter((r) => r.status === 'Open');
  const bands = { notPast: 0, b1: 0, b2: 0, b3: 0, over: 0, noDate: 0 };
  const ages = [];
  let past = 0, oldest = 0;
  open.forEach((r) => {
    const age = daysBetween_(r.raisedDate, asOf);
    if (age != null) { ages.push(age); oldest = Math.max(oldest, age); }
    const late = r.expectedDate ? daysBetween_(r.expectedDate, asOf) : null;
    if (late == null) bands.noDate++;
    else if (late <= 0) bands.notPast++;
    else {
      past++;
      if (late <= b1) bands.b1++; else if (late <= b2) bands.b2++; else if (late <= b3) bands.b3++; else bands.over++;
    }
  });
  const checked = live.filter((r) => r.capaCheck === 'Effective' || r.capaCheck === 'Not effective');
  const eff = checked.filter((r) => r.capaCheck === 'Effective').length;
  const w = wilson(eff, checked.length);
  const target = (+cfg.capaTarget || 80) / 100;
  const capaState = !checked.length ? 'none' : w.lo >= target ? 'good' : w.p >= target ? 'watch' : 'action';

  const byCat = {};
  live.forEach((r) => { const c = r.category || 'Not classified'; byCat[c] = (byCat[c] || 0) + 1; });
  const pareto = Object.keys(byCat).map((k) => ({ label: k, value: byCat[k] })).sort((a, b) => b.value - a.value);

  const byOwner = {};
  live.forEach((r) => { const c = r.contractor || 'Not stated'; (byOwner[c] = byOwner[c] || { label: c, issued: 0, open: 0, past: 0 }).issued++; });
  open.forEach((r) => {
    const o = byOwner[r.contractor || 'Not stated']; o.open++;
    if (r.expectedDate && daysBetween_(r.expectedDate, asOf) > 0) o.past++;
  });

  return {
    issued: live.length,
    open: open.length,
    pastExpected: past,
    pastPct: open.length ? past / open.length : null,
    over90: bands.over,
    medianAge: median_(ages),
    oldest: oldest,
    awaiting: open.filter((r) => r.awaitingResponse === true).length,
    repeat: live.filter((r) => r.repeat === true).length,
    bands: bands,
    bandEdges: [b1, b2, b3],
    capa: { k: eff, n: checked.length, p: w.p, lo: w.lo, hi: w.hi, state: capaState, target: target },
    pareto: pareto,
    owners: Object.keys(byOwner).map((k) => byOwner[k]).sort((a, b) => b.open - a.open),
  };
}

/** NCR/OBS raised per month over the last n months ending with asOf's month. */
function ncrMonthly(ncrs, asOf, n) {
  n = n || 12;
  const end = periodOf_(asOf), months = [];
  for (let i = n - 1; i >= 0; i--) months.push(shiftPeriod_(end, -i));
  const counts = months.map((m) => ncrs.filter((r) => r.status !== 'Cancelled' && r.raisedDate && periodOf_(r.raisedDate) === m).length);
  const closed = months.map((m) => ncrs.filter((r) => r.closedDate && periodOf_(r.closedDate) === m).length);
  return { months: months, raised: counts, closed: closed, chart: cChart(counts) };
}

/* ---------------- assessments, coverage, milestones ---------------- */

function latestApproved(assessments, projectId, beforePeriod) {
  return assessments
    .filter((a) => a.projectId === projectId && a.state === 'Approved' && (!beforePeriod || a.period < beforePeriod))
    .sort((a, b) => (a.period < b.period ? 1 : -1))[0] || null;
}

function finalOf(a) { return a ? a.final || a.overall : null; }

/** Is a Level 4 assessment due for this project in this period? Tier 1 monthly; Tier 2 quarterly (Mar, Jun, Sep, Dec); Tier 3 at milestones. */
function assessmentDue(project, period) {
  if (project.status !== 'Active') return false;
  if (String(project.tier) === '1') return true;
  if (String(project.tier) === '2') return ['03', '06', '09', '12'].indexOf(period.slice(5, 7)) >= 0;
  return false;
}

function coverage(projects, assessments, period) {
  const due = projects.filter((p) => assessmentDue(p, period));
  const done = due.filter((p) => assessments.some((a) => a.projectId === p.id && a.period === period && a.state === 'Approved'));
  return { period: period, due: due.length, done: done.length, pct: due.length ? done.length / due.length : null, missing: due.filter((p) => done.indexOf(p) < 0).map((p) => p.id) };
}

function milestoneStatus(m, asOf) {
  if (m.actual) return { status: 'Achieved', variance: m.baseline ? daysBetween_(m.baseline, m.actual) : null };
  if (m.baseline && m.forecast) {
    const v = daysBetween_(m.baseline, m.forecast);
    if (v > 0) return { status: 'Late', variance: v };
    if (daysBetween_(m.forecast, asOf) > 0) return { status: 'Past forecast', variance: daysBetween_(m.baseline, asOf) };
    return { status: 'On track', variance: v };
  }
  if (m.baseline && daysBetween_(m.baseline, asOf) > 0) return { status: 'Past baseline', variance: daysBetween_(m.baseline, asOf) };
  if (!m.forecast) return { status: 'Not reported', variance: null };
  return { status: 'On track', variance: null };
}

/* ---------------- alert engine ---------------- */

const SEVERITY_ORDER = { Critical: 0, High: 1, Medium: 2, Low: 3 };

/**
 * Alerts are derived from the records each time; they clear themselves when the condition clears.
 * Each alert: { id, rule, severity, band, projectId, title, detail, date, owner, link }.
 */
function computeAlerts(db, asOf, cfg) {
  const out = [];
  const proj = {};
  db.Projects.forEach((p) => { proj[p.id] = p; });
  const active = (id) => proj[id] && proj[id].status === 'Active';
  const leadOf = (id) => (proj[id] && proj[id].lead) || '';
  const push = (a) => { a.id = a.rule + ':' + (a.ref || a.projectId || ''); out.push(a); };

  // Findings
  db.Findings.forEach((f) => {
    if (!active(f.projectId)) return;
    if (f.severity === 'Critical' && f.status !== 'Closed' && f.status !== 'Verified effective') {
      push({ rule: 'FINDING_CRITICAL', ref: f.id, severity: 'Critical', band: 'Assurance assessment', projectId: f.projectId, title: 'Critical finding open: ' + f.title, detail: f.id + ' · responsible party ' + (f.responsibleParty || '—'), date: f.raisedDate, owner: f.qaOwner, link: { view: 'Findings', id: f.id } });
    }
    if (f.status === 'Open' && f.responseDue && daysBetween_(f.responseDue, asOf) > 0) {
      push({ rule: 'FINDING_RESPONSE_OVERDUE', ref: f.id, severity: f.severity === 'Critical' || f.severity === 'Major' ? 'High' : 'Medium', band: 'Assurance assessment', projectId: f.projectId, title: f.severity + ' finding without a response', detail: f.id + ' — response from ' + (f.responsibleParty || 'the responsible party') + ' was due ' + nice_(f.responseDue) + '.', date: f.responseDue, owner: f.qaOwner, link: { view: 'Findings', id: f.id } });
    }
    if (f.status === 'Implemented' && f.effectivenessDue) {
      const d = daysBetween_(f.effectivenessDue, asOf);
      if (d > 0) push({ rule: 'EFFECTIVENESS_OVERDUE', ref: f.id, severity: 'High', band: 'Assurance assessment', projectId: f.projectId, title: 'Effectiveness check overdue', detail: f.id + ' was due for verification on ' + nice_(f.effectivenessDue) + '.', date: f.effectivenessDue, owner: f.qaOwner, link: { view: 'Findings', id: f.id } });
      else if (d > -7) push({ rule: 'EFFECTIVENESS_DUE', ref: f.id, severity: 'Medium', band: 'Assurance assessment', projectId: f.projectId, title: 'Effectiveness check due within 7 days', detail: f.id + ' — due ' + nice_(f.effectivenessDue) + '.', date: f.effectivenessDue, owner: f.qaOwner, link: { view: 'Findings', id: f.id } });
    }
  });

  // Systemic signal: the same area raised as a finding on three or more projects
  const byArea = {};
  db.Findings.filter((f) => active(f.projectId) && f.area && ['Closed', 'Verified effective'].indexOf(f.status) < 0)
    .forEach((f) => { (byArea[f.area] = byArea[f.area] || []).push(f); });
  Object.keys(byArea).forEach((k) => {
    const fs = byArea[k], ps = {};
    fs.forEach((f) => { ps[f.projectId] = 1; });
    if (Object.keys(ps).length >= 3) {
      const area = AREAS[+k - 1];
      push({ rule: 'SYSTEMIC_SIGNAL', ref: 'area' + k, severity: 'High', band: 'Assurance assessment', projectId: '', title: 'Systemic signal: ' + (area ? area.title : 'area ' + k), detail: fs.length + ' open findings across ' + Object.keys(ps).length + ' projects (' + fs.map((f) => f.id).join(', ') + ').', date: fs.map((f) => f.raisedDate).sort()[0], owner: '', link: { view: 'Findings' } });
    }
  });

  // NCR ageing, per project (Level 2 references)
  const byProj = {};
  db.NCRs.forEach((r) => { (byProj[r.projectId] = byProj[r.projectId] || []).push(r); });
  Object.keys(byProj).forEach((pid) => {
    if (!active(pid)) return;
    const s = ncrStats(byProj[pid], asOf, cfg);
    if (s.over90) push({ rule: 'NCR_OVER_TOP_BAND', projectId: pid, severity: 'High', band: 'NCR & CAPA', title: s.over90 + ' NCR/OBS more than ' + s.bandEdges[2] + ' days past expected completion', detail: s.open + ' open · ' + s.pastExpected + ' past expected · oldest ' + s.oldest + ' days. Level 2 records owned by the project.', date: asOf, owner: leadOf(pid), link: { view: 'NCRs', projectId: pid } });
    else if (s.bands.b2 + s.bands.b3) push({ rule: 'NCR_AGEING', projectId: pid, severity: 'Medium', band: 'NCR & CAPA', title: (s.bands.b2 + s.bands.b3) + ' NCR/OBS more than ' + s.bandEdges[0] + ' days past expected completion', detail: s.open + ' open · median age ' + Math.round(s.medianAge || 0) + ' days.', date: asOf, owner: leadOf(pid), link: { view: 'NCRs', projectId: pid } });
    if (s.capa.state === 'action' && s.capa.n >= 5) push({ rule: 'CAPA_NOT_EFFECTIVE', projectId: pid, severity: 'High', band: 'NCR & CAPA', title: 'CAPA verified effective below target', detail: Math.round(s.capa.p * 100) + '% of ' + s.capa.n + ' checked (target ' + Math.round(s.capa.target * 100) + '%).', date: asOf, owner: leadOf(pid), link: { view: 'NCRs', projectId: pid } });
    const rep = byProj[pid].filter((r) => r.repeat === true && r.status === 'Open');
    if (rep.length) push({ rule: 'REPEAT_SIGNAL', projectId: pid, severity: rep.length >= 3 ? 'Critical' : 'High', band: 'NCR & CAPA', title: 'Repeat NCRs after corrective action', detail: rep.length + ' open repeat NCR/OBS (' + rep.slice(0, 4).map((r) => r.ref).join(', ') + (rep.length > 4 ? ', …' : '') + ').', date: rep.map((r) => r.raisedDate).sort()[0], owner: leadOf(pid), link: { view: 'NCRs', projectId: pid } });
  });

  // Escalations
  db.Escalations.forEach((e) => {
    if (e.status !== 'Open') return;
    if (e.stopWork) push({ rule: 'STOP_WORK', ref: e.id, severity: 'Critical', band: 'Projects', projectId: e.projectId, title: 'Stop-work / hold in force', detail: e.ask + (e.raisedDate ? ' · day ' + daysBetween_(e.raisedDate, asOf) : ''), date: e.raisedDate, owner: leadOf(e.projectId), link: { view: 'Escalations', id: e.id } });
    if (e.dueDate && daysBetween_(e.dueDate, asOf) > 0) push({ rule: 'ESCALATION_NO_RESPONSE', ref: e.id, severity: e.level === 'C' ? 'Critical' : 'High', band: 'Assurance assessment', projectId: e.projectId, title: 'Level ' + e.level + ' escalation without response', detail: (e.owner || 'Accountable executive') + ' — due ' + nice_(e.dueDate) + '.', date: e.dueDate, owner: leadOf(e.projectId), link: { view: 'Escalations', id: e.id } });
  });

  // Milestones
  db.Milestones.forEach((m) => {
    if (!active(m.projectId) || m.critical === false) return;
    const st = milestoneStatus(m, asOf);
    if (st.status === 'Late' || st.status === 'Past baseline' || st.status === 'Past forecast') push({ rule: 'MILESTONE_AT_RISK', ref: m.id, severity: 'High', band: 'Projects', projectId: m.projectId, title: 'Critical milestone at risk: ' + m.item, detail: 'Baseline ' + nice_(m.baseline) + ', forecast ' + (m.forecast ? nice_(m.forecast) : 'not reported') + (st.variance ? ' (' + st.variance + ' days)' : '') + '.', date: m.baseline || asOf, owner: leadOf(m.projectId), link: { view: 'Milestones', id: m.id } });
  });

  // Assessments: last completed period due and not approved; latest approved Red
  const lastPeriod = shiftPeriod_(periodOf_(asOf), -1);
  const lateFrom = +String(asOf).slice(8, 10) > 7;
  db.Projects.forEach((p) => {
    if (p.status !== 'Active') return;
    if (lateFrom && assessmentDue(p, lastPeriod) && !db.Assessments.some((a) => a.projectId === p.id && a.period === lastPeriod && a.state === 'Approved')) {
      push({ rule: 'ASSESSMENT_OVERDUE', projectId: p.id, severity: 'High', band: 'Assurance assessment', title: 'Level 4 assessment for ' + nice_(lastPeriod) + ' not approved', detail: 'Tier ' + p.tier + ' — submit by working day 3, approve by working day 5.', date: lastPeriod + '-07', owner: p.lead, link: { view: 'Assessments', projectId: p.id } });
    }
    const la = latestApproved(db.Assessments, p.id);
    if (la && finalOf(la) === 'Red') push({ rule: 'PROJECT_RED', projectId: p.id, severity: 'High', band: 'Assurance assessment', title: 'Level 4 position Red', detail: 'Approved for ' + nice_(la.period) + ' — management intervention or heightened assurance required.', date: la.approvedAt ? String(la.approvedAt).slice(0, 10) : la.period + '-01', owner: p.lead, link: { view: 'Assessment', id: la.id } });
    if ((String(p.tier) === '1' || String(p.tier) === '2') && p.pqp !== 'Approved' && p.pqp !== 'N/A') push({ rule: 'PQP_MISSING', projectId: p.id, severity: 'Medium', band: 'Projects', title: 'No approved Project Quality Plan', detail: 'Tier ' + p.tier + ' project · PQP ' + (p.pqp || 'not recorded') + '.', date: p.startDate || asOf, owner: p.lead, link: { view: 'Project', id: p.id } });
  });

  // Tasks
  db.Tasks.forEach((t) => {
    if (['Accepted'].indexOf(t.status) >= 0 || !t.due) return;
    if (t.status !== 'Submitted' && daysBetween_(t.due, asOf) > 0) push({ rule: 'TASK_OVERDUE', ref: t.id, severity: t.priority === 'High' ? 'High' : 'Low', band: 'Work & performance', projectId: t.projectId || '', title: 'Task overdue: ' + t.title, detail: t.id + ' was due ' + nice_(t.due) + '.', date: t.due, owner: t.assignee, link: { view: 'Tasks', id: t.id } });
  });

  return out.sort((a, b) => (SEVERITY_ORDER[a.severity] - SEVERITY_ORDER[b.severity]) || String(a.date || '').localeCompare(String(b.date || '')));
}

/* ---------------- Command Centre roll-up ---------------- */

function worstOf_(statuses) {
  if (statuses.indexOf('Red') >= 0) return 'Red';
  if (statuses.indexOf('Amber') >= 0 || statuses.indexOf('Grey') >= 0) return 'Amber';
  if (statuses.indexOf('Green') >= 0) return 'Green';
  return 'Not assessed';
}

function buildDashboard(db, asOf, cfg) {
  const alerts = computeAlerts(db, asOf, cfg);
  const period = periodOf_(asOf);
  const covPeriod = shiftPeriod_(period, -1);
  const active = db.Projects.filter((p) => p.status === 'Active');

  const heat = active.map((p) => {
    const la = latestApproved(db.Assessments, p.id);
    const prev = la ? latestApproved(db.Assessments, p.id, la.period) : null;
    const now = finalOf(la), before = finalOf(prev);
    let change = '';
    if (now && before && now in STATUS_RANK && before in STATUS_RANK) change = STATUS_RANK[now] > STATUS_RANK[before] ? 'worse' : STATUS_RANK[now] < STATUS_RANK[before] ? 'better' : 'same';
    const pending = db.Assessments.filter((a) => a.projectId === p.id && (a.state === 'Submitted' || a.state === 'Draft')).length;
    return {
      projectId: p.id, code: p.code, name: p.name, programme: p.programme, tier: p.tier, tierStatus: p.tierStatus, lead: p.lead,
      assessmentId: la ? la.id : null, period: la ? la.period : null, areas: la ? areaStatuses(la) : null,
      overall: now || 'Not assessed', moderated: !!(la && la.moderatedTo), change: change, pending: pending,
      escalations: db.Escalations.filter((e) => e.projectId === p.id && e.status === 'Open').length,
      critMaj: db.Findings.filter((f) => f.projectId === p.id && (f.severity === 'Critical' || f.severity === 'Major') && ['Closed', 'Verified effective'].indexOf(f.status) < 0).length,
    };
  });

  const count = (s) => heat.filter((h) => h.overall === s).length;
  const programmes = ['Portfolio'].concat(PROGRAMMES).map((prog) => {
    const ids = active.filter((p) => prog === 'Portfolio' || p.programme === prog).map((p) => p.id);
    if (prog !== 'Portfolio' && !ids.length) return null;
    const inP = (r) => ids.indexOf(r.projectId) >= 0;
    const rows = heat.filter(inP);
    const al = alerts.filter((a) => (a.projectId ? inP(a) : prog === 'Portfolio'));
    return {
      programme: prog,
      projects: ids.length,
      overall: worstOf_(rows.map((r) => r.overall)),
      assessed: rows.filter((r) => r.overall !== 'Not assessed').length,
      ncr: ncrStats(db.NCRs.filter(inP), asOf, cfg),
      decisions: db.Escalations.filter((e) => inP(e) && e.status === 'Open' && (e.level === 'B' || e.level === 'C')).length,
      alerts: { total: al.length, critical: al.filter((a) => a.severity === 'Critical').length, high: al.filter((a) => a.severity === 'High').length },
      top: al[0] || null,
    };
  }).filter(Boolean);

  const milestones = db.Milestones.filter((m) => m.critical !== false && active.some((p) => p.id === m.projectId))
    .map((m) => Object.assign({}, m, milestoneStatus(m, asOf)))
    .sort((a, b) => String(a.forecast || a.baseline || '9').localeCompare(String(b.forecast || b.baseline || '9')));

  const findingsOpen = db.Findings.filter((f) => ['Closed', 'Verified effective'].indexOf(f.status) < 0);
  const bySev = {};
  findingsOpen.forEach((f) => { bySev[f.severity] = (bySev[f.severity] || 0) + 1; });

  return {
    asOf: asOf,
    period: period,
    counts: { Red: count('Red'), Amber: count('Amber'), Green: count('Green'), Grey: count('Grey'), 'Not assessed': count('Not assessed') },
    overall: worstOf_(heat.map((h) => h.overall)),
    heat: heat,
    programmes: programmes,
    alerts: alerts,
    coverage: coverage(db.Projects, db.Assessments, covPeriod),
    findings: { open: findingsOpen.length, bySeverity: bySev, effectivenessDue: db.Findings.filter((f) => f.status === 'Implemented').length },
    escalations: { open: db.Escalations.filter((e) => e.status === 'Open').length, stopWork: db.Escalations.filter((e) => e.status === 'Open' && e.stopWork).length },
    milestones: milestones,
    monthly: ncrMonthly(db.NCRs, asOf, 12),
  };
}

/* ===== Db.gs ===== */
/**
 * Sheet storage. Each register is a tab whose first row holds the column keys.
 * Columns are found by name, so people may reorder or add columns in the Sheet.
 */

class AppError extends Error {
  constructor(code, message) { super(message); this.code = code; }
}

let SS_CACHE_ = null;

/** The backing Sheet: the container of this script, or the one recorded by setup(). */
function ss_() {
  if (SS_CACHE_) return SS_CACHE_;
  SS_CACHE_ = SpreadsheetApp.getActive();
  if (!SS_CACHE_) {
    const id = PropertiesService.getScriptProperties().getProperty('QTRACK_SHEET_ID');
    if (!id) throw new AppError('NOT_SET_UP', 'Q-TRACK has no Sheet yet. Lead – QA should run setup() from the Apps Script editor of the Sheet.');
    SS_CACHE_ = SpreadsheetApp.openById(id);
  }
  return SS_CACHE_;
}

let TZ_CACHE_ = null;
function tz_() {
  if (!TZ_CACHE_) TZ_CACHE_ = ss_().getSpreadsheetTimeZone() || Session.getScriptTimeZone() || 'Asia/Kuala_Lumpur';
  return TZ_CACHE_;
}

function todayIso_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }
function nowStamp_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd HH:mm'); }

function columnsOf_(table) {
  return SYS_COLUMNS.slice(0, 1).concat(TABLES[table].fields.map((f) => f.k), SYS_COLUMNS.slice(1));
}

function fieldMap_(table) {
  const m = {};
  TABLES[table].fields.forEach((f) => { m[f.k] = f; });
  return m;
}

function sheetOf_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new AppError('NOT_SET_UP', 'The “' + name + '” tab is missing. Lead – QA should run setup() from the Apps Script editor.');
  return sh;
}

/** Converts a raw cell value to the field's type. */
function fromCell_(v, f, key) {
  if (v instanceof Date) {
    const withTime = /At$/.test(key);
    return Utilities.formatDate(v, tz_(), withTime ? 'yyyy-MM-dd HH:mm' : f && f.type === 'month' ? 'yyyy-MM' : 'yyyy-MM-dd');
  }
  if (typeof v === 'string' && v.charAt(0) === "'") v = v.slice(1);
  if (!f) return key === 'rev' ? Number(v) || 0 : v === null || v === undefined ? '' : String(v);
  switch (f.type) {
    case 'bool': return v === true || /^(true|yes|y|1)$/i.test(String(v));
    case 'number': return v === '' || v === null ? null : Number(v);
    case 'json':
      if (v === '' || v === null) return f.def === undefined ? null : f.def;
      try { return JSON.parse(v); } catch (e) { return f.def === undefined ? null : f.def; }
    default: return v === null || v === undefined ? '' : String(v).trim();
  }
}

function toCell_(v, f) {
  if (f && f.type === 'json') return v === null || v === undefined ? '' : JSON.stringify(v);
  if (f && f.type === 'bool') return v ? 'TRUE' : 'FALSE';
  if (v === null || v === undefined) return '';
  const s = String(v);
  return /^[=+\-@]/.test(s) ? "'" + s : s; // never let a value become a formula
}

/** Reads a whole register as records. Each record carries its sheet row in _row. */
function readTable_(table) {
  const sh = sheetOf_(table);
  const values = sh.getDataRange().getValues();
  if (values.length < 1) return [];
  const head = values[0].map((h) => String(h).trim());
  const fm = fieldMap_(table);
  const out = [];
  for (let r = 1; r < values.length; r++) {
    const row = values[r];
    const idCol = head.indexOf('id');
    if (idCol < 0 || !row[idCol]) continue;
    const rec = { _row: r + 1 };
    head.forEach((h, c) => { if (h) rec[h] = fromCell_(row[c], fm[h], h); });
    TABLES[table].fields.forEach((f) => { if (!(f.k in rec)) rec[f.k] = f.def === undefined ? '' : f.def; });
    out.push(rec);
  }
  return out;
}

/** The tab's header row, adding any schema columns that are missing. */
function headOf_(table) {
  const sh = sheetOf_(table);
  const head = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0].map((h) => String(h).trim());
  const missing = columnsOf_(table).filter((k) => head.indexOf(k) < 0);
  if (missing.length) {
    const start = head.filter(Boolean).length === 0 ? 1 : head.length + 1;
    if (start === 1) head.length = 0;
    sh.getRange(1, start, 1, missing.length).setValues([missing]);
    missing.forEach((k) => head.push(k));
  }
  return head;
}

function writeRow_(table, rec) {
  const sh = sheetOf_(table);
  const head = headOf_(table);
  const fm = fieldMap_(table);
  const row = head.map((h) => (h ? toCell_(rec[h], fm[h]) : ''));
  const rowNum = rec._row || sh.getLastRow() + 1;
  const range = sh.getRange(rowNum, 1, 1, head.length);
  range.setNumberFormat('@');
  range.setValues([row]);
  return rowNum;
}

function deleteRow_(table, rowNum) { sheetOf_(table).deleteRow(rowNum); }

function nextId_(table, rows) {
  const t = TABLES[table];
  let max = 0;
  rows.forEach((r) => {
    const m = new RegExp('^' + t.prefix + '-(\\d+)$').exec(r.id);
    if (m) max = Math.max(max, +m[1]);
  });
  return t.prefix + '-' + String(max + 1).padStart(t.pad || 4, '0');
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new AppError('BUSY', 'Q-TRACK is busy saving someone else’s change. Try again in a moment.');
  try { return fn(); } finally { lock.releaseLock(); }
}

function audit_(email, action, table, id, summary) {
  const sh = ss_().getSheetByName(AUDIT_SHEET);
  if (!sh) return;
  sh.appendRow([nowStamp_(), email, action, table, id, toCell_(String(summary || '').slice(0, 2000))]);
}

function readConfig_() {
  const cfg = Object.assign({}, CONFIG_DEFAULTS);
  const sh = ss_().getSheetByName(CONFIG_SHEET);
  if (!sh) return cfg;
  sh.getDataRange().getValues().slice(1).forEach((r) => {
    const k = String(r[0]).trim();
    if (!(k in CONFIG_DEFAULTS)) return;
    const d = CONFIG_DEFAULTS[k];
    cfg[k] = typeof d === 'boolean' ? r[1] === true || /^true$/i.test(String(r[1])) : typeof d === 'number' ? Number(r[1]) || d : String(r[1]);
  });
  return cfg;
}

function writeConfig_(cfg) {
  const sh = ss_().getSheetByName(CONFIG_SHEET) || ss_().insertSheet(CONFIG_SHEET);
  const rows = [['key', 'value']].concat(Object.keys(CONFIG_DEFAULTS).map((k) => [k, String(cfg[k] === undefined ? CONFIG_DEFAULTS[k] : cfg[k])]));
  sh.clearContents();
  sh.getRange(1, 1, rows.length, 2).setNumberFormat('@').setValues(rows);
}

/** Copies a record without internal keys, for sending to the browser. */
function public_(rec) {
  const o = {};
  Object.keys(rec).forEach((k) => { if (k.charAt(0) !== '_') o[k] = rec[k]; });
  return o;
}

/* ===== Auth.gs ===== */
/**
 * Who is signed in, and what they may read and change.
 * The browser hides what a role cannot do; these checks are what actually enforce it.
 *
 * Roles (Config.gs ROLES):
 *   LEAD   Lead – QA: everything. Approves, returns and moderates assessments, accepts
 *          deliverables, issues the monthly report, manages users, settings and deletions.
 *   MGR    Manager: works across every project (assessments, findings, NCR/OBS, escalations,
 *          milestones, risks), assigns and re-dates tasks for the team and accepts deliverables.
 *          Does not approve assessments, issue reports, manage users or delete.
 *   AM     Assistant Manager: the projects allocated to them as QA lead or deputy, plus their
 *          own tasks and weekly updates.
 *   CLERK  Admin clerk: users (not Lead – QA), the project register, NCR/OBS references,
 *          milestones and bulk imports, plus their own tasks and weekly updates.
 *   VIEWER Management: read-only, approved assessments and issued reports only.
 */

function currentEmail_() {
  return String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
}

function me_(users) {
  const email = currentEmail_();
  if (!email) throw new AppError('NO_IDENTITY', 'Q-TRACK could not read your Google account. Open it while signed in to your MRTC Google account.');
  const u = (users || readTable_('Users')).find((x) => String(x.email).toLowerCase() === email);
  if (!u || u.active === false) throw new AppError('NOT_REGISTERED', email);
  return u;
}

function isStaff_(u) { return u.role !== 'VIEWER'; }
function isLead_(u) { return u.role === 'LEAD'; }

/** Projects where the user is the QA lead or deputy. */
function ownProjectIds_(u, projects) {
  const e = String(u.email).toLowerCase();
  return projects.filter((p) => String(p.lead).toLowerCase() === e || String(p.deputy).toLowerCase() === e).map((p) => p.id);
}

/** Registers each role can see. */
const ALL_TABLES_ = ['Users', 'Projects', 'Assessments', 'Findings', 'NCRs', 'Escalations', 'Milestones', 'Risks', 'Tasks', 'Weekly', 'Reports'];
const READ = {
  LEAD: ALL_TABLES_,
  MGR: ALL_TABLES_,
  AM: ALL_TABLES_,
  CLERK: ALL_TABLES_,
  VIEWER: ['Users', 'Projects', 'Assessments', 'Escalations', 'Milestones', 'Risks', 'Reports'],
};

/** Row-level filtering on read. */
function visibleRows_(table, rows, u) {
  if ((READ[u.role] || []).indexOf(table) < 0) return [];
  if (u.role === 'VIEWER') {
    if (table === 'Assessments') return rows.filter((r) => r.state === 'Approved');
    if (table === 'Reports') return rows.filter((r) => r.state === 'Issued');
    if (table === 'Users') return rows.map((r) => ({ id: r.id, email: r.email, name: r.name, code: r.code, role: r.role, title: r.title, active: r.active }));
  }
  if (table === 'Reports' && !isLead_(u)) return rows.filter((r) => r.state === 'Issued');
  return rows;
}

/** Fields of a project that only Lead – QA may change. */
const PROJECT_LEAD_FIELDS_ = ['code', 'tier', 'tierStatus', 'lead', 'deputy'];

/**
 * May this user create (before = null) or change this record into `after`?
 * Returns null when allowed, or the reason it is not.
 */
function writeDenied_(table, u, before, after, projects) {
  const role = u.role;
  if (role === 'VIEWER') return 'Your role is read-only.';
  if (role === 'LEAD') return null;
  if (!READ[role]) return 'Unknown role.';
  const own = ownProjectIds_(u, projects);
  const me = String(u.email).toLowerCase();
  const is = (v) => String(v || '').toLowerCase() === me;
  const same = (a, b) => String(a || '').toLowerCase() === String(b || '').toLowerCase();
  // Record is within the user's project scope: Managers and the clerk reach every project,
  // Assistant Managers only the ones allocated to them.
  const scoped = (r) => !r || !r.projectId || role === 'MGR' || role === 'CLERK' || own.indexOf(r.projectId) >= 0;
  const inScope = (r) => scoped(r);

  switch (table) {
    case 'Users':
      if (role !== 'CLERK') return 'Only Lead – QA and the admin clerk manage users.';
      if (after.role === 'LEAD' || (before && before.role === 'LEAD')) return 'Only Lead – QA can grant or change the Lead – QA role.';
      return null;

    case 'Projects':
      if (role === 'CLERK') return null;
      if (!before) return 'Ask Lead – QA or the admin clerk to add a project.';
      if (role === 'AM' && own.indexOf(before.id) < 0) return 'You can update only projects where you are the QA lead or deputy.';
      if (PROJECT_LEAD_FIELDS_.some((k) => !same(before[k], after[k]))) return 'Only Lead – QA changes the project code, tier or QA allocation.';
      return null;

    case 'Assessments':
      if (role === 'CLERK') return 'Assessments are prepared by QA officers and approved by Lead – QA.';
      if (!inScope(after) || (before && !inScope(before))) return 'You can prepare assessments only for projects allocated to you.';
      return null;

    case 'Findings':
      if (role === 'CLERK') return 'Findings are raised by QA officers.';
      if (inScope(after) && (!before || inScope(before))) return null;
      if (before && is(before.qaOwner) && is(after.qaOwner)) return null;
      return 'You can change findings on your projects, or ones you own.';

    case 'NCRs':
    case 'Milestones':
      return inScope(after) && inScope(before) ? null : 'You can update this register only for projects allocated to you.';

    case 'Escalations':
    case 'Risks':
      if (role === 'CLERK') return 'Escalations and risks are recorded by QA officers.';
      return inScope(after) && inScope(before) ? null : 'You can update this register only for projects allocated to you.';

    case 'Tasks':
      if (role === 'MGR') {
        if (after.status === 'Accepted' && (!before || before.status !== 'Accepted') && is(after.assignee)) return 'Your own deliverables are accepted by Lead – QA.';
        return null;
      }
      if (!before) return is(after.assignee) ? null : 'Only Lead – QA or a Manager assigns tasks to other people.';
      if (!is(before.assignee)) return 'You can update only tasks assigned to you.';
      if (!is(after.assignee)) return 'Only Lead – QA or a Manager re-assigns tasks.';
      if (after.status === 'Accepted' && before.status !== 'Accepted') return 'Lead – QA or a Manager accepts deliverables.';
      if (before.due !== after.due) return 'Ask Lead – QA or a Manager to change a due date.';
      return null;

    case 'Weekly':
      return !before || is(before.createdBy) ? null : 'You can edit only your own weekly updates.';

    case 'Reports':
      return 'Only Lead – QA prepares and issues the monthly report.';
  }
  return 'Not permitted.';
}

/** May this user submit an assessment for approval? */
function canSubmitAssessment_(u, a, projects) {
  if (isLead_(u) || u.role === 'MGR') return true;
  return u.role === 'AM' && ownProjectIds_(u, projects).indexOf(a.projectId) >= 0;
}

function canDelete_(table, u, rec) {
  if (isLead_(u)) return true;
  if (table === 'Weekly' && String(rec.createdBy).toLowerCase() === String(u.email).toLowerCase()) return true;
  return false;
}

/* ===== Api.gs ===== */
/**
 * The one entry point the browser calls: google.script.run.api(action, payloadJson).
 * Every answer is a JSON string { ok, data } or { ok: false, code, message }.
 */

const ACTIONS = {
  bootstrap: bootstrap_,
  save: save_,
  remove: remove_,
  assessmentSubmit: (p) => assessmentMove_(p, 'submit'),
  assessmentApprove: (p) => assessmentMove_(p, 'approve'),
  assessmentReturn: (p) => assessmentMove_(p, 'return'),
  reportIssue: reportIssue_,
  configSave: configSave_,
  importRows: importRows_,
  auditList: auditList_,
};

function api(action, payloadJson) {
  try {
    const fn = ACTIONS[action];
    if (!fn) throw new AppError('BAD_ACTION', 'Unknown action ' + action);
    const payload = payloadJson ? JSON.parse(payloadJson) : {};
    return JSON.stringify({ ok: true, data: fn(payload) });
  } catch (e) {
    if (!(e instanceof AppError)) console.error(action, e && e.stack);
    return JSON.stringify({ ok: false, code: e.code || 'ERROR', message: e instanceof AppError ? e.message : 'Q-TRACK hit an unexpected problem: ' + (e && e.message) });
  }
}

function loadDb_(tables) {
  const db = {};
  (tables || Object.keys(TABLES)).forEach((t) => { db[t] = readTable_(t); });
  return db;
}

/* ---------------- read ---------------- */

function bootstrap_() {
  const db = loadDb_();
  const user = me_(db.Users);
  const cfg = readConfig_();
  const asOf = todayIso_();
  const data = {};
  Object.keys(TABLES).forEach((t) => { data[t] = visibleRows_(t, db[t], user).map(public_); });

  // The dashboard is built from what this role may see (a viewer sees approved assessments only).
  const seen = {};
  Object.keys(TABLES).forEach((t) => { seen[t] = visibleRows_(t, db[t], user); });
  if (user.role === 'VIEWER') { seen.Findings = db.Findings; seen.NCRs = db.NCRs; seen.Tasks = []; }
  const dash = buildDashboard(seen, asOf, cfg);
  if (user.role === 'VIEWER') dash.alerts = dash.alerts.filter((a) => a.severity === 'Critical' || a.severity === 'High').map((a) => Object.assign({}, a, { owner: '' }));

  const lastChange = Object.keys(TABLES).reduce((best, t) => db[t].reduce((b, r) => (String(r.updatedAt) > String(b.at) ? { at: r.updatedAt, by: r.updatedBy } : b), best), { at: '', by: '' });

  return {
    app: APP,
    me: public_(user),
    roles: ROLES,
    areas: AREAS,
    schema: TABLES,
    configFields: CONFIG_FIELDS,
    config: cfg,
    asOf: asOf,
    tz: tz_(),
    data: data,
    dashboard: dash,
    ownProjects: ownProjectIds_(user, db.Projects),
    lastChange: lastChange,
    sheetUrl: isLead_(user) ? ss_().getUrl() : '',
  };
}

function auditList_(p) {
  const u = me_();
  if (!isLead_(u)) throw new AppError('DENIED', 'The audit log is open to Lead – QA only.');
  const sh = sheetOf_(AUDIT_SHEET);
  const n = sh.getLastRow() - 1;
  if (n < 1) return [];
  const take = Math.min(n, (p && p.limit) || 500);
  return sh.getRange(sh.getLastRow() - take + 1, 1, take, AUDIT_COLUMNS.length).getValues().reverse()
    .map((r) => { const o = {}; AUDIT_COLUMNS.forEach((k, i) => { o[k] = fromCell_(r[i], null, k); }); return o; });
}

/* ---------------- validation ---------------- */

function resolveDefault_(def, u, today) {
  if (def === '$today') return today;
  if (def === '$me') return u.email;
  if (def === '$friday') return fridayOf_(today);
  return def;
}

/** Cleans an incoming record against the schema. Unknown and system fields are dropped. */
function clean_(table, input, before, u, db, today) {
  const t = TABLES[table];
  const out = {};
  const errors = [];
  const users = db.Users.map((x) => String(x.email).toLowerCase());
  const projects = db.Projects.map((x) => x.id);
  t.fields.forEach((f) => {
    if (f.sys) return;
    if (f.leadOnly && !isLead_(u)) { out[f.k] = before ? before[f.k] : f.type === 'bool' ? false : f.type === 'json' ? f.def : ''; return; }
    let v = input.hasOwnProperty(f.k) ? input[f.k] : before ? before[f.k] : resolveDefault_(f.def, u, today);
    if (v === undefined || v === null) v = f.type === 'bool' ? false : f.type === 'json' ? f.def : '';
    switch (f.type) {
      case 'bool': v = v === true || v === 'true'; break;
      case 'number': v = v === '' ? null : Number(v); if (v !== null && isNaN(v)) errors.push(f.label + ' must be a number.'); break;
      case 'json': break;
      default:
        v = String(v).trim();
        if (v.length > (f.type === 'longtext' ? 5000 : 300)) errors.push(f.label + ' is too long.');
    }
    if (f.type === 'date' && v && !/^\d{4}-\d{2}-\d{2}$/.test(v)) errors.push(f.label + ' must be a date (yyyy-mm-dd).');
    if (f.type === 'month' && v && !/^\d{4}-\d{2}$/.test(v)) errors.push(f.label + ' must be a month (yyyy-mm).');
    if (f.type === 'enum' && v !== '' && f.options.indexOf(v) < 0) errors.push(f.label + ': “' + v + '” is not one of the allowed values.');
    if (f.type === 'user' && v) { v = v.toLowerCase(); if (users.indexOf(v) < 0) errors.push(f.label + ': ' + v + ' is not a Q-TRACK user.'); }
    if (f.type === 'project' && v && projects.indexOf(v) < 0) errors.push(f.label + ': unknown project.');
    if (f.req && (v === '' || v === null)) errors.push(f.label + ' is required.');
    out[f.k] = v;
  });
  if (errors.length) throw new AppError('INVALID', errors.join(' '));
  return out;
}

function diffSummary_(table, before, after) {
  if (!before) return 'created';
  const t = TABLES[table];
  const ch = t.fields.filter((f) => JSON.stringify(before[f.k]) !== JSON.stringify(after[f.k])).map((f) => f.k + ': ' + String(JSON.stringify(before[f.k])).slice(0, 80) + ' → ' + String(JSON.stringify(after[f.k])).slice(0, 80));
  return ch.join('; ') || 'no change';
}

/* ---------------- table-specific rules ---------------- */

function hooks_(table, rec, before, u, db) {
  const dupe = (rows, pred) => rows.some((r) => r.id !== rec.id && pred(r));
  if (table === 'Users') {
    rec.email = rec.email.toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(rec.email)) throw new AppError('INVALID', 'Enter a valid e-mail address.');
    if (dupe(db.Users, (r) => String(r.email).toLowerCase() === rec.email)) throw new AppError('INVALID', rec.email + ' already has an account.');
    if (before && before.email.toLowerCase() === String(u.email).toLowerCase() && (rec.role !== 'LEAD' || rec.active === false) && isLead_(u) && db.Users.filter((x) => x.role === 'LEAD' && x.active !== false).length < 2) throw new AppError('INVALID', 'Keep at least one active Lead – QA account.');
  }
  if (table === 'Projects' && dupe(db.Projects, (r) => String(r.code).toLowerCase() === String(rec.code).toLowerCase())) throw new AppError('INVALID', 'Project code ' + rec.code + ' is already used.');
  if (table === 'NCRs' && dupe(db.NCRs, (r) => r.projectId === rec.projectId && String(r.ref).toLowerCase() === String(rec.ref).toLowerCase())) throw new AppError('INVALID', rec.ref + ' is already recorded for this project.');
  if (table === 'NCRs' && rec.status === 'Closed' && !rec.closedDate) throw new AppError('INVALID', 'Give the closed date for a closed NCR / OBS.');
  if (table === 'Reports') {
    if (before && before.state === 'Issued') throw new AppError('LOCKED', 'This report has been issued and is frozen.');
    if (dupe(db.Reports, (r) => r.period === rec.period)) throw new AppError('INVALID', 'A report for ' + rec.period + ' already exists.');
  }
  if (table === 'Assessments') {
    if (before && ['Draft', 'Returned'].indexOf(before.state) < 0 && !(isLead_(u) && before.state === 'Submitted')) throw new AppError('LOCKED', 'This assessment is ' + before.state.toLowerCase() + ' and can no longer be edited.');
    // At review Lead – QA may only moderate; the assessor's ratings and evidence stay as submitted.
    if (before && before.state === 'Submitted') TABLES.Assessments.fields.forEach((f) => { if (f.k !== 'moderatedTo' && f.k !== 'moderationNote') rec[f.k] = before[f.k]; });
    if (dupe(db.Assessments, (r) => r.projectId === rec.projectId && r.period === rec.period)) throw new AppError('INVALID', 'An assessment for this project and period already exists.');
    if (!Array.isArray(rec.evidence)) rec.evidence = [];
    rec.evidence = rec.evidence.slice(0, 10).map((s) => String(s || '').slice(0, 3000));
    rec.overall = overallFromAreas(areaStatuses(rec));
    const why = checkModeration(rec.overall, rec.moderatedTo, rec.moderationNote);
    if (why) throw new AppError('INVALID', why);
    rec.final = rec.moderatedTo || rec.overall;
    if (!before) rec.state = 'Draft';
  }
}

/* ---------------- write ---------------- */

function save_(p) {
  const table = p.table;
  if (!TABLES[table]) throw new AppError('BAD_TABLE', 'Unknown register.');
  return withLock_(() => {
    const db = loadDb_(['Users', 'Projects'].concat(['Users', 'Projects'].indexOf(table) < 0 ? [table] : []));
    const u = me_(db.Users);
    const rows = db[table];
    const today = todayIso_();
    const input = p.record || {};
    const before = input.id ? rows.find((r) => r.id === input.id) : null;
    if (input.id && !before) throw new AppError('NOT_FOUND', 'That record no longer exists. It may have been deleted.');
    if (before && Number(before.rev) !== Number(input.rev)) throw new AppError('CONFLICT', 'Someone else changed this record (' + (before.updatedBy || 'unknown') + ', ' + before.updatedAt + ') after you opened it. Reload it and make your change again.');
    const after = Object.assign({}, before || {}, clean_(table, input, before, u, db, today));
    if (before) TABLES[table].fields.filter((f) => f.sys).forEach((f) => { after[f.k] = before[f.k]; });
    else TABLES[table].fields.filter((f) => f.sys).forEach((f) => { after[f.k] = f.def === undefined ? '' : f.def; });
    const denied = writeDenied_(table, u, before, after, db.Projects);
    if (denied) throw new AppError('DENIED', denied);
    hooks_(table, after, before, u, db);
    const stamp = nowStamp_();
    if (!before) { after.id = nextId_(table, rows); after.createdAt = stamp; after.createdBy = u.email; after.rev = 0; }
    after.rev = Number(after.rev || 0) + 1;
    after.updatedAt = stamp;
    after.updatedBy = u.email;
    after._row = writeRow_(table, after);
    audit_(u.email, before ? 'update' : 'create', table, after.id, diffSummary_(table, before, after));
    return public_(after);
  });
}

function remove_(p) {
  if (!TABLES[p.table]) throw new AppError('BAD_TABLE', 'Unknown register.');
  return withLock_(() => {
    const u = me_();
    const rows = readTable_(p.table);
    const rec = rows.find((r) => r.id === p.id);
    if (!rec) throw new AppError('NOT_FOUND', 'That record no longer exists.');
    if (!canDelete_(p.table, u, rec)) throw new AppError('DENIED', 'Only Lead – QA deletes records. Set the status to Closed or Cancelled instead.');
    if (p.table === 'Assessments' && rec.state === 'Approved') throw new AppError('LOCKED', 'Approved assessments are kept as the record of assurance.');
    if (p.table === 'Reports' && rec.state === 'Issued') throw new AppError('LOCKED', 'Issued reports are kept as the record.');
    deleteRow_(p.table, rec._row);
    audit_(u.email, 'delete', p.table, rec.id, JSON.stringify(public_(rec)).slice(0, 1800));
    return { id: rec.id };
  });
}

function assessmentMove_(p, move) {
  return withLock_(() => {
    const db = loadDb_(['Users', 'Projects', 'Assessments']);
    const u = me_(db.Users);
    const a = db.Assessments.find((r) => r.id === p.id);
    if (!a) throw new AppError('NOT_FOUND', 'Assessment not found.');
    if (Number(a.rev) !== Number(p.rev)) throw new AppError('CONFLICT', 'This assessment changed since you opened it. Reload and try again.');
        const stamp = nowStamp_();
    if (move === 'submit') {
      if (!canSubmitAssessment_(u, a, db.Projects)) throw new AppError('DENIED', 'Only the project’s QA lead or deputy, a Manager or Lead – QA submits an assessment.');
      if (['Draft', 'Returned'].indexOf(a.state) < 0) throw new AppError('LOCKED', 'Only a draft or returned assessment can be submitted.');
      const missing = AREAS.filter((ar, i) => { const s = a['a' + (i + 1)]; return s !== 'N/A' && s !== 'Green' && !String((a.evidence || [])[i] || '').trim(); });
      if (missing.length) throw new AppError('INVALID', 'Give the evidence basis for every area that is not Green or N/A: ' + missing.map((m) => m.n).join(', ') + '.');
      if (!String(a.conclusion || '').trim()) throw new AppError('INVALID', 'Write the overall conclusion before submitting.');
      a.state = 'Submitted'; a.submittedAt = stamp; a.returnNote = '';
    } else {
      if (!isLead_(u)) throw new AppError('DENIED', 'Only Lead – QA approves or returns assessments.');
      if (a.state !== 'Submitted') throw new AppError('LOCKED', 'Only a submitted assessment can be ' + (move === 'approve' ? 'approved' : 'returned') + '.');
      if (move === 'approve') {
        a.state = 'Approved'; a.approvedBy = u.email; a.approvedAt = stamp; a.final = a.moderatedTo || a.overall;
      } else {
        if (!p.note || String(p.note).trim().length < 5) throw new AppError('INVALID', 'Say what needs to change.');
        a.state = 'Returned'; a.returnNote = String(p.note).slice(0, 1000);
      }
    }
    a.rev = Number(a.rev) + 1; a.updatedAt = stamp; a.updatedBy = u.email;
    writeRow_('Assessments', a);
    audit_(u.email, move, 'Assessments', a.id, 'state → ' + a.state + (a.returnNote ? ' (' + a.returnNote + ')' : ''));
    return public_(a);
  });
}

function reportIssue_(p) {
  return withLock_(() => {
    const db = loadDb_();
    const u = me_(db.Users);
    if (!isLead_(u)) throw new AppError('DENIED', 'Only Lead – QA issues the monthly report.');
    const r = db.Reports.find((x) => x.id === p.id);
    if (!r) throw new AppError('NOT_FOUND', 'Report not found.');
    if (r.state === 'Issued') throw new AppError('LOCKED', 'Already issued.');
    if (Number(r.rev) !== Number(p.rev)) throw new AppError('CONFLICT', 'This report changed since you opened it. Reload and try again.');
    if (!r.overall || !String(r.conclusion || '').trim()) throw new AppError('INVALID', 'Set the overall status and conclusion before issuing.');
    const end = shiftPeriod_(r.period, 1) + '-01';
    const asOf = addDays_(end, -1) < todayIso_() ? addDays_(end, -1) : todayIso_();
    const dash = buildDashboard(db, asOf, readConfig_());
    r.snapshot = {
      asOf: asOf,
      heat: dash.heat, counts: dash.counts, coverage: dash.coverage,
      programmes: dash.programmes.map((x) => ({ programme: x.programme, overall: x.overall, ncr: x.ncr, decisions: x.decisions })),
      monthly: dash.monthly,
      risks: db.Risks.filter((x) => x.status === 'Open').map(public_),
      findings: db.Findings.filter((f) => ['Closed', 'Verified effective'].indexOf(f.status) < 0 && (f.severity === 'Critical' || f.severity === 'Major')).map(public_),
      escalations: db.Escalations.filter((e) => e.status === 'Open').map(public_),
      projects: db.Projects.map((x) => ({ id: x.id, code: x.code, name: x.name, programme: x.programme })),
    };
    const stamp = nowStamp_();
    r.state = 'Issued'; r.issuedBy = u.email; r.issuedAt = stamp;
    r.rev = Number(r.rev) + 1; r.updatedAt = stamp; r.updatedBy = u.email;
    writeRow_('Reports', r);
    audit_(u.email, 'issue', 'Reports', r.id, 'issued ' + r.period);
    return public_(r);
  });
}

function configSave_(p) {
  return withLock_(() => {
    const u = me_();
    if (!isLead_(u)) throw new AppError('DENIED', 'Only Lead – QA changes settings.');
    const cfg = readConfig_();
    CONFIG_FIELDS.forEach((f) => {
      if (!(f.k in (p.config || {}))) return;
      const v = p.config[f.k];
      cfg[f.k] = f.type === 'bool' ? v === true : f.type === 'number' ? Math.max(0, Number(v) || CONFIG_DEFAULTS[f.k]) : String(v).slice(0, 200);
    });
    if (!(cfg.ncrBand1 < cfg.ncrBand2 && cfg.ncrBand2 < cfg.ncrBand3)) throw new AppError('INVALID', 'The NCR ageing bands must increase (for example 30, 60, 90).');
    writeConfig_(cfg);
    audit_(u.email, 'config', CONFIG_SHEET, '', JSON.stringify(cfg));
    return cfg;
  });
}

/**
 * Bulk load rows into a register. dryRun returns what would happen; commit writes all or nothing.
 * Rows are objects keyed by field key or field label.
 */
function importRows_(p) {
  const table = p.table;
  if (['Projects', 'NCRs', 'Milestones', 'Findings', 'Risks', 'Users'].indexOf(table) < 0) throw new AppError('BAD_TABLE', 'This register cannot be imported.');
  const run = () => {
    const db = loadDb_(['Users', 'Projects'].concat(['Users', 'Projects'].indexOf(table) < 0 ? [table] : []));
    const u = me_(db.Users);
    if (!isLead_(u) && u.role !== 'CLERK') throw new AppError('DENIED', 'Imports are run by Lead – QA or the admin clerk.');
    const t = TABLES[table];
    const byLabel = {};
    t.fields.forEach((f) => { byLabel[f.k.toLowerCase()] = f.k; byLabel[f.label.toLowerCase()] = f.k; });
    const codeToId = {};
    db.Projects.forEach((x) => { codeToId[String(x.code).toLowerCase()] = x.id; codeToId[x.id.toLowerCase()] = x.id; });
    const today = todayIso_();
    const results = [];
    const staged = db[table].slice();
    (p.rows || []).slice(0, 2000).forEach((raw, i) => {
      const rec = {};
      Object.keys(raw).forEach((h) => { const k = byLabel[String(h).trim().toLowerCase()]; if (k) rec[k] = raw[h]; });
      if (rec.projectId) rec.projectId = codeToId[String(rec.projectId).trim().toLowerCase()] || rec.projectId;
      try {
        const after = clean_(table, rec, null, u, db, today);
        TABLES[table].fields.filter((f) => f.sys).forEach((f) => { after[f.k] = f.def === undefined ? '' : f.def; });
        const denied = writeDenied_(table, u, null, after, db.Projects);
        if (denied) throw new AppError('DENIED', denied);
        const dbView = Object.assign({}, db); dbView[table] = staged;
        hooks_(table, after, null, u, dbView);
        after.id = nextId_(table, staged);
        staged.push(after);
        results.push({ row: i + 2, ok: true, id: after.id, rec: after });
      } catch (e) {
        results.push({ row: i + 2, ok: false, message: e.message });
      }
    });
    const bad = results.filter((r) => !r.ok);
    if (!p.commit || bad.length) return { committed: false, total: results.length, errors: bad, preview: results.filter((r) => r.ok).slice(0, 20).map((r) => r.rec) };
    const stamp = nowStamp_();
    const sh = sheetOf_(table);
    const head = headOf_(table);
    const fm = fieldMap_(table);
    const out = results.map((r) => {
      const rec = Object.assign(r.rec, { rev: 1, createdAt: stamp, createdBy: u.email, updatedAt: stamp, updatedBy: u.email });
      return head.map((h) => toCell_(rec[h], fm[h]));
    });
    if (out.length) sh.getRange(sh.getLastRow() + 1, 1, out.length, head.length).setNumberFormat('@').setValues(out);
    audit_(u.email, 'import', table, '', out.length + ' rows');
    return { committed: true, total: out.length, errors: [] };
  };
  return p.commit ? withLock_(run) : run();
}

/* ===== Setup.gs ===== */
/**
 * One-time setup and sample data. Run setup() once from the Apps Script editor
 * (or Q-TRACK → Set up or repair tabs in the Sheet). It is safe to run again.
 */

function setup() {
  const ss = ss_();
  PropertiesService.getScriptProperties().setProperty('QTRACK_SHEET_ID', ss.getId());
  Object.keys(TABLES).forEach((t) => {
    const sh = ss.getSheetByName(t) || ss.insertSheet(t);
    headOf_(t);
    sh.getRange(1, 1, Math.max(sh.getMaxRows(), 2), sh.getMaxColumns()).setNumberFormat('@');
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, sh.getLastColumn()).setFontWeight('bold').setBackground('#0B2A6F').setFontColor('#FFFFFF');
  });
  if (!ss.getSheetByName(CONFIG_SHEET)) writeConfig_(CONFIG_DEFAULTS);
  const audit = ss.getSheetByName(AUDIT_SHEET) || ss.insertSheet(AUDIT_SHEET);
  if (audit.getLastRow() === 0) audit.getRange(1, 1, 1, AUDIT_COLUMNS.length).setValues([AUDIT_COLUMNS]).setFontWeight('bold');
  audit.setFrozenRows(1);
  const blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);

  // The person running setup becomes the first Lead – QA.
  const email = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  const users = readTable_('Users');
  if (email && !users.some((u) => String(u.email).toLowerCase() === email)) {
    const stamp = nowStamp_();
    writeRow_('Users', { id: nextId_('Users', users), email: email, name: email.split('@')[0], code: 'LQ', role: 'LEAD', title: 'Lead – QA', active: true, rev: 1, createdAt: stamp, createdBy: email, updatedAt: stamp, updatedBy: email });
    audit_(email, 'setup', 'Users', '', 'first Lead – QA account');
  }
  notify_('Q-TRACK is set up. Next: Deploy → New deployment → Web app (Execute as: Me; Who has access: Anyone within your organisation).');
}

function notify_(msg) {
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.log(msg); }
}

